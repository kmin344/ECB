# Copy to .env and fill in. Docker Compose reads .env from this folder.
# Token signing secret shared by all services. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Payments (Stripe Checkout). Without these, checkout answers 503 and the rest of the store works.
# Test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Webhook endpoint: <STORE_URL>/api/payments/webhook, events checkout.session.*
# Local testing: stripe listen --forward-to localhost/api/payments/webhook
STRIPE_WEBHOOK_SECRET=
# Public address of the storefront; Stripe sends shoppers back here.
STORE_URL=http://localhost
# ISO currency of the product prices, for example usd, eur, krw.
STORE_CURRENCY=usd
